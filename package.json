{
  "name": "@openkakutou/web-ui-kit",
  "version": "0.4.0",
  "description": "Shared design system (Web Components + CSS custom-property tokens) for every OpenKakutou viewer/editor/mode web app.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openkakutou/web-ui-kit.git"
  },
  "homepage": "https://github.com/openkakutou/web-ui-kit#readme",
  "bugs": {
    "url": "https://github.com/openkakutou/web-ui-kit/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": ["dist"],
  "exports": {
    ".": "./dist/web-ui-kit.js",
    "./tokens.css": "./dist/web-ui-kit.css"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check --write .",
    "verify-pack": "node --experimental-strip-types src/publish/verify-pack.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.13.1",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
